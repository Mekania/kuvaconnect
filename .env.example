# ─── KuvaConnect ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta lo que necesites.

# Puerto del servidor
PORT=3000

# PIN del panel de moderacion. CAMBIALO antes de un evento real.
ADMIN_PIN=2468

# URL publica que se codifica en el QR.
# Si lo dejas vacio, usa http://<IP de tu LAN>:<PORT> automaticamente.
# Ponlo solo si expones el servidor con un tunel (Cloudflare, ngrok) o un dominio.
PUBLIC_BASE_URL=

# Limites de subida
MAX_UPLOAD_MB=25
MAX_PER_DEVICE=12

# ─── Google Drive ────────────────────────────────────────────────────────────
# Ponlo en true DESPUES de correr: npm run drive:auth
DRIVE_ENABLED=false

# Permisos de Drive. Por defecto la app solo accede a lo que ella misma crea
# (sin pantalla de "app no verificada"). Ponlo en true SOLO si vas a usar
# DRIVE_ROOT_FOLDER_ID apuntando a una carpeta que creaste tu a mano.
DRIVE_FULL_ACCESS=false

# Opcional: ID de una carpeta ya existente donde colgar todo.
# Si lo dejas vacio, KuvaConnect crea una carpeta llamada KuvaConnect en la raiz.
DRIVE_ROOT_FOLDER_ID=

# Solo si usas una Unidad compartida de Workspace con service account:
DRIVE_SHARED_DRIVE_ID=

# Cada cuanto intenta subir lo pendiente (ms)
DRIVE_SYNC_INTERVAL_MS=15000

# ─── Impresion ───────────────────────────────────────────────────────────────
# 300 dpi sobre 4x6 pulgadas = 1200x1800 px, que es el 10x15 de las DNP.
PRINT_DPI=300
